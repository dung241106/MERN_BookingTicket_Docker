PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
MONGODB_URL=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB_NAME=quickshow

# Same Clerk application/instance as client/.env
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# This project uses USD Stripe Checkout. Secret key stays on the server.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Copy from `stripe listen` locally, or the endpoint signing secret when deployed.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Bearer credential: TMDB API Read Access Token (not the shorter v3 API key).
TMDB_API_KEY=REPLACE_WITH_API_READ_ACCESS_TOKEN

# Inngest Cloud: both keys must belong to the same Cloud environment.
INNGEST_DEV=0
INNGEST_EVENT_KEY=REPLACE_WITH_CLOUD_EVENT_KEY
INNGEST_SIGNING_KEY=REPLACE_WITH_CURRENT_CLOUD_SIGNING_KEY

SMTP_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASS=REPLACE_WITH_BREVO_SMTP_KEY
SENDER_EMAIL=REPLACE_WITH_VERIFIED_SENDER_EMAIL

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_UTC_OFFSET=+07:00
